# Copy to .env and fill in. Never commit real values.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
PAYPAL_WEBHOOK_ID=
# Sandbox business accounts we own (payee registry) and the sandbox buyer who approves orders.
DEMO_MERCHANT_1_EMAIL=
DEMO_MERCHANT_2_EMAIL=
DEMO_BUYER_EMAIL=
DEMO_BUYER_PASSWORD=
TOKEN_TTL_SECONDS=600
# Two DIFFERENT random values (e.g. `openssl rand -hex 32`). The agent process must never get HUMAN_API_KEY.
AGENT_API_KEY=
HUMAN_API_KEY=

# Demo-video agent model (planner): openrouter (default) | local; model id per provider.
SHOPPER_MODEL_PROVIDER=
SHOPPER_MODEL=
